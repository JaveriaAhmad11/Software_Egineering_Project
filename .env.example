GEMINI_API_KEY=your_gemini_api_key_here
# Default model chosen from the Sprint 2 audit (SCRUM-47); gemini-3.8-flash timed out in 3/3 test calls
GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds before one API attempt is abandoned
GEMINI_TIMEOUT_S=45
# Attempts per call before GeminiCallFailed is raised
GEMINI_MAX_RETRIES=3
